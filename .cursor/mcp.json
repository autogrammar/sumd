{
  "mcpServers": {
    "koru": {
      "command": "koru",
      "args": [
        "mcp-serve"
      ],
      "transport": "stdio",
      "env": {
        "ENV2LLM_CONTEXT": "${workspaceFolder}/.nlp2dsl/registry/environment.doql.less",
        "NLP2DSL_DOQL_CONTEXT": "${workspaceFolder}/.nlp2dsl/registry/environment.doql.less",
        "KORU_PROJECT_ROOT": "${workspaceFolder}"
      }
    }
  }
}
